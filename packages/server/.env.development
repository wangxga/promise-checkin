# 开发环境配置
NODE_ENV=development
PORT=3000
CORS_ORIGIN=*

# 数据库（本地 Docker MySQL）
DATABASE_URL=mysql://promise_app:promise_app@localhost:3306/promise_checkin

# Redis（本地）
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# JWT（开发用固定密钥）
JWT_SECRET=dev-secret-change-me-in-production-at-least-32-chars
JWT_ACCESS_EXPIRES_SECONDS=604800
JWT_REFRESH_EXPIRES_SECONDS=2592000

# 微信小程序（开发环境可为空，dev 后门兜底）
WX_APPID=wx46dd3b6b2cb46029
WX_SECRET=41ffca063ba282ce57ec35cc89574c2f

# 日志
LOG_LEVEL=debug

# dev 后门（开发环境登录跳过微信 code2Session）
DEV_AUTO_LOGIN=true
