{
  "name": "@promise-checkin/server",
  "version": "0.1.0",
  "private": true,
  "description": "如约打卡后端 — Koa2 + Prisma + MySQL + Redis",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/app.ts",
    "build": "tsc",
    "start": "node dist/app.js",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "fix:offset": "tsx src/scripts/fix-offset-checkins.ts"
  },
  "dependencies": {
    "@koa/cors": "^5.0.0",
    "@koa/multer": "^3.0.2",
    "@koa/router": "^12.0.1",
    "@prisma/client": "^5.17.0",
    "@promise-checkin/shared": "workspace:*",
    "dotenv": "^16.4.5",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "koa": "^2.15.3",
    "koa-bodyparser": "^4.4.1",
    "koa-logger": "^3.2.1",
    "koa-mount": "^4.2.0",
    "koa-static": "^5.0.0",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^4.5.0",
    "pino": "^9.3.2",
    "pino-pretty": "^11.2.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.6",
    "@types/koa": "^2.15.0",
    "@types/koa-bodyparser": "^4.3.12",
    "@types/koa-logger": "^3.1.3",
    "@types/koa-mount": "^4.0.5",
    "@types/koa-static": "^4.0.4",
    "@types/koa__cors": "^5.0.0",
    "@types/koa__multer": "^2.0.8",
    "@types/koa__router": "^12.0.4",
    "@types/multer": "^1.4.12",
    "@types/node": "^20.14.12",
    "@types/node-cron": "^3.0.11",
    "prisma": "^5.17.0",
    "tsx": "^4.16.2",
    "typescript": "^5.5.0"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
